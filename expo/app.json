{
  "expo": {
    "name": "JEROC Gårdsapp",
    "slug": "jeroc-gardsapp-demo",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": ["ios", "android"],
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "JEROC ansluter till din dator för att visa gårdsappen i demoläge.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoadsInWebContent": true
        }
      }
    }
  }
}
