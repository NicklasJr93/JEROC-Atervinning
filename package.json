{
  "name": "jeroc-gardsapp-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:render": "npm run build && npm --prefix expo ci --include=dev --no-audit --no-fund && npm run expo:check",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "test": "playwright test",
    "test:server": "node --test server/*.test.mjs",
    "test:ui": "playwright test --ui",
    "expo": "node scripts/start-expo.mjs",
    "expo:check": "npm --prefix expo run typecheck"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.0"
  }
}
