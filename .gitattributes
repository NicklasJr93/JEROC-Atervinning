* text=auto
*.command text eol=lf
*.cmd text eol=crlf
*.png binary
*.pdf binary

# Preserve generated audit evidence byte-for-byte, including CSV line endings
# and whitespace emitted by the test runner.
public/bokforing/granskning/*.csv -text whitespace=cr-at-eol
public/bokforing/granskning/*.txt -text -whitespace

public/bokforing/granskning/atgarder/*.csv -text whitespace=cr-at-eol
public/bokforing/granskning/atgarder/*.txt -text -whitespace
